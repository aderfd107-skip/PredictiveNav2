<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="mrt_gazebo_plugins" params="robot_name:=robot">
    <gazebo reference="base_link">
      <material>Gazebo/Blue</material>
    </gazebo>

    <gazebo reference="left_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="right_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>

    <gazebo reference="front_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

    <gazebo reference="rear_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
    </gazebo>

    <!-- Gazebo Harmonic integration will be finalized in mrt_simulation.
         This block keeps actuator and sensor intent close to the model. -->
    <gazebo>
      <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
        <left_joint>left_wheel_joint</left_joint>
        <right_joint>right_wheel_joint</right_joint>
        <wheel_separation>0.51</wheel_separation>
        <wheel_radius>0.08</wheel_radius>
        <odom_publish_frequency>50</odom_publish_frequency>
        <topic>${robot_name}/cmd_vel</topic>
        <odom_topic>${robot_name}/odom</odom_topic>
        <tf_topic>${robot_name}/tf</tf_topic>
        <frame_id>${robot_name}/odom</frame_id>
        <child_frame_id>${robot_name}/base_footprint</child_frame_id>
      </plugin>
    </gazebo>

    <gazebo reference="lidar_link">
      <sensor name="${robot_name}_lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <topic>${robot_name}/scan</topic>
        <gz_frame_id>${robot_name}/lidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>720</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.08</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </gazebo>

    <gazebo reference="imu_link">
      <sensor name="${robot_name}_imu" type="imu">
        <topic>${robot_name}/imu</topic>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
