<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>predictive_nav_mppi</name>
  <version>0.1.0</version>
  <description>MPPI DynamicRiskCritic extension for PredictiveNav2.</description>
  <maintainer email="aderfd@example.com">aderfd</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- These are declared now so later critic steps do not change package scope. -->
  <depend>rclcpp</depend>
  <depend>nav2_mppi_controller</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>predictive_nav_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_mppi_controller plugin="${prefix}/predictive_nav_mppi_critics.xml" />
  </export>
</package>
