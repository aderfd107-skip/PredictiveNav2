Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Map1
        - /LaserScan1
        - /Scan-Derived Clusters (Debug)1
        - /Gazebo Ground Truth (Debug)1
      Splitter Ratio: 0.5
    Tree Height: 450
  - Class: nav2_rviz_plugins/Navigation 2
    Name: Nav2
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.7
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Enabled: true
      Name: Map
      Topic:
        Value: /map
    - Class: rviz_default_plugins/RobotModel
      Description Topic:
        Value: /robot_description
      Enabled: true
      Name: RobotModel
    - Class: rviz_default_plugins/LaserScan
      Enabled: true
      Name: LaserScan
      Size (m): 0.03
      Style: Points
      Topic:
        Value: /scan
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Gazebo Ground Truth (Debug)
      Topic:
        Value: /dynamic_obstacle/ground_truth_marker
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Marker Topic:
        Value: /dynamic_obstacles/cluster_markers
      Name: Scan-Derived Clusters (Debug)
    - Class: rviz_default_plugins/Path
      Color: 25; 255; 0
      Enabled: true
      Name: Global Path
      Topic:
        Value: /plan
    - Class: rviz_default_plugins/Path
      Color: 255; 0; 0
      Enabled: true
      Name: Local Path
      Topic:
        Value: /local_plan
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Name: TF
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: nav2_rviz_plugins/GoalTool
      Name: Nav2 Goal
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
  Value: true
Window Geometry:
  Height: 846
  Width: 1200
  X: 65
  Y: 50
