    <model name="narrow_passage_top_block">
      <static>true</static>
      <pose>3.75 -1.45 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.4 0.55 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.4 0.55 0.9</size></box></geometry><material><ambient>0.50 0.54 0.58 1</ambient><diffuse>0.50 0.54 0.58 1</diffuse></material></visual>
      </link>
    </model>

    <model name="narrow_passage_bottom_block">
      <static>true</static>
      <pose>3.75 -2.75 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.4 0.55 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.4 0.55 0.9</size></box></geometry><material><ambient>0.50 0.54 0.58 1</ambient><diffuse>0.50 0.54 0.58 1</diffuse></material></visual>
      </link>
    </model>

    <model name="storage_printer_partition">
      <static>true</static>
      <pose>-3.0 -3.9 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 1.8 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 1.8 1.2</size></box></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material></visual>
      </link>
