    <model name="printer_charging_partition">
      <static>true</static>
      <pose>1.5 -3.9 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 1.8 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 1.8 1.2</size></box></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Furniture and semantic fixtures. -->
    <model name="front_service_counter">
      <static>true</static>
      <pose>-5.45 -1.75 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.8 0.42 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.8 0.42 0.7</size></box></geometry><material><ambient>0.36 0.24 0.16 1</ambient><diffuse>0.36 0.24 0.16 1</diffuse></material></visual>
      </link>
    </model>

    <model name="storage_shelf">
      <static>true</static>
      <pose>-5.35 -3.85 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.7 0.35 0.9</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.7 0.35 0.9</size></box></geometry><material><ambient>0.25 0.32 0.38 1</ambient><diffuse>0.25 0.32 0.38 1</diffuse></material></visual>
      </link>
    </model>

    <model name="printer_block">
      <static>true</static>
      <pose>-0.8 -3.85 0.35 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.9 0.55 0.7</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.9 0.55 0.7</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <model name="charging_station_1">
      <static>true</static>
      <pose>4.5 -4.55 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.75 0.35 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.75 0.35 0.4</size></box></geometry><material><ambient>0.05 0.38 0.18 1</ambient><diffuse>0.05 0.38 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <model name="charging_station_2">
      <static>true</static>
      <pose>5.8 -4.55 0.2 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.75 0.35 0.4</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.75 0.35 0.4</size></box></geometry><material><ambient>0.05 0.38 0.18 1</ambient><diffuse>0.05 0.38 0.18 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Robot home / spawn pads: visual-only markers in front of charging stations. -->
    <model name="spawn_pad_robot_1">
      <static>true</static>
      <pose>5.8 -3.85 0.0075 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.82 0.62 0.015</size></box></geometry><material><ambient>0.0 0.25 1.0 0.65</ambient><diffuse>0.0 0.25 1.0 0.65</diffuse></material></visual>
      </link>
    </model>

    <model name="spawn_pad_robot_2">
      <static>true</static>
      <pose>4.5 -3.85 0.0075 0 0 1.5708</pose>
      <link name="link">
        <visual name="visual"><geometry><box><size>0.82 0.62 0.015</size></box></geometry><material><ambient>1.0 0.42 0.0 0.65</ambient><diffuse>1.0 0.42 0.0 0.65</diffuse></material></visual>
      </link>
    </model>

    <!-- Task point markers: cylinders are visual landmarks only. -->
    <model name="marker_pickup_front_desk">
      <static>true</static>
      <pose>-5.5 -0.65 0.0125 0 0 0</pose>
      <link name="link">
        <visual name="visual"><geometry><cylinder><radius>0.10</radius><length>0.025</length></cylinder></geometry><material><ambient>0.0 0.6 1.0 1</ambient><diffuse>0.0 0.6 1.0 1</diffuse></material></visual>
