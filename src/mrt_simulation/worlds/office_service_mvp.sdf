        <visual name="visual"><geometry><box><size>2.8 0.12 1.2</size></box></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material></visual>
      </link>
    </model>

    <model name="front_office_partition">
      <static>true</static>
      <pose>-3.0 -2.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 2.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 2.0 1.2</size></box></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material></visual>
