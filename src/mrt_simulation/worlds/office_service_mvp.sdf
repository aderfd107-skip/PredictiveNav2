<?xml version="1.0"?>
<sdf version="1.9">
  <world name="office_service_mvp">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gui fullscreen="0">
      <camera name="overview_camera">
        <pose>0 -11 12 1.05 0 0</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>100</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.4 0.4 -0.8</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>14.5 10.5</size>
            </plane>
          </geometry>
        </collision>
      </link>
    </model>

    <!-- Outer walls: 14m x 10m boundary, wall height 1.2m. -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 5.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14.0 0.12 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14.0 0.12 1.2</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -5.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>14.0 0.12 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>14.0 0.12 1.2</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>7.0 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 10.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 10.0 1.2</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-7.0 0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 10.0 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 10.0 1.2</size></box></geometry><material><ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Upper room partitions, leaving door openings into the main corridor. -->
    <model name="upper_corridor_wall_left">
      <static>true</static>
      <pose>-4.75 1.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.5 0.12 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.5 0.12 1.2</size></box></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material></visual>
      </link>
    </model>

    <model name="upper_corridor_wall_mid">
      <static>true</static>
      <pose>-0.35 1.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.7 0.12 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>2.7 0.12 1.2</size></box></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material></visual>
      </link>
    </model>

    <model name="upper_corridor_wall_right">
      <static>true</static>
      <pose>4.55 1.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>4.2 0.12 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>4.2 0.12 1.2</size></box></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material></visual>
      </link>
    </model>

    <model name="upper_partition_a_equipment">
      <static>true</static>
      <pose>-2.4 3.45 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 3.1 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 3.1 1.2</size></box></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material></visual>
      </link>
    </model>

    <model name="upper_partition_equipment_b">
      <static>true</static>
      <pose>1.6 3.45 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.12 3.1 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 3.1 1.2</size></box></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Lower service area partitions. -->
    <model name="lower_corridor_wall_left_west">
      <static>true</static>
      <pose>-6.3 -1.0 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.4 0.12 1.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>1.4 0.12 1.2</size></box></geometry><material><ambient>0.78 0.78 0.76 1</ambient><diffuse>0.78 0.78 0.76 1</diffuse></material></visual>
      </link>
    </model>

    <model name="lower_corridor_wall_left_east">
      <static>true</static>
      <pose>-3.6 -1.0 0.6 0 0 0</pose>
