<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="predictive_nav_base" params="robot_color:=predictive_nav_blue base_radius:=0.110 base_height:=0.060 base_ground_clearance:=0.005 base_link_z:=0.0325">
    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <!-- base_footprint is the ground-plane centre; base_link is the wheel axle plane. -->
      <origin xyz="0 0 ${base_link_z}" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
      <visual>
        <origin xyz="0 0 ${base_ground_clearance + base_height / 2.0 - base_link_z}" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${base_radius}" length="${base_height}"/>
        </geometry>
        <material name="${robot_color}"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${base_ground_clearance + base_height / 2.0 - base_link_z}" rpy="0 0 0"/>
        <geometry>
          <!-- Simple circular collision body: appropriate for Nav2/Gazebo, not a CAD model. -->
          <cylinder radius="${base_radius}" length="${base_height}"/>
        </geometry>
      </collision>
      <!-- PROVISIONAL_DESIGN_VALUE: update mass/inertia after the robot is weighed. -->
      <xacro:predictive_nav_cylinder_inertia_z mass="4.0" radius="${base_radius}" length="${base_height}"/>
    </link>

    <link name="top_deck_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <cylinder radius="${base_radius - 0.006}" length="0.004"/>
        </geometry>
        <material name="predictive_nav_dark_grey"/>
      </visual>
      <!-- Deck/electronics are visual-only so they do not enlarge collision or Nav2 footprint. -->
      <xacro:predictive_nav_cylinder_inertia_z mass="0.15" radius="${base_radius - 0.006}" length="0.004"/>
    </link>

    <joint name="top_deck_joint" type="fixed">
      <parent link="base_link"/>
      <child link="top_deck_link"/>
      <origin xyz="0 0 ${base_ground_clearance + base_height - base_link_z}" rpy="0 0 0"/>
    </joint>
  </xacro:macro>
</robot>
